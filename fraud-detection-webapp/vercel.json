{
       "builds": [
           {
               "src": "src/package.json",
               "use": "@vercel/static-build",
               "config": {
                   "distDir": "src/out"
               }
           }
       ],
       "routes": [
           {
               "src": "/api/(.*)",
               "dest": "/src/pages/api/$1"
           }
       ]
   }